# ============================================
# RECURRA — ENVIRONMENT VARIABLES
# NEVER commit .env files with real values!
# Copy this to .env and fill in your values.
# ============================================

# ===== APPLICATION =====
NODE_ENV=development
APP_PORT=3001
APP_HOST=localhost
APP_NAME=recurra
LOG_LEVEL=info

# ===== DATABASE (PostgreSQL) =====
DATABASE_URL=postgresql://recurra_user:CHANGE_ME@localhost:5432/recurra_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# ===== REDIS =====
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_TLS=false

# ===== AUTHENTICATION =====
JWT_SECRET=CHANGE_ME_TO_A_SECURE_64_CHAR_RANDOM_STRING
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=recurra.io

# ===== STELLAR NETWORK =====
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ===== CONTRACT ADDRESSES (Testnet) =====
CONTRACT_AUTHORIZATION_MANAGER=
CONTRACT_SUBSCRIPTION_FACTORY=
CONTRACT_PAYMENT_ENGINE=
CONTRACT_TOKEN_WRAPPER=
CONTRACT_ESCROW_DISPUTE=
USDC_TOKEN_ADDRESS=

# ===== KEEPER SERVICE =====
KEEPER_PRIVATE_KEY=NEVER_COMMIT_THIS
KEEPER_CRON_SCHEDULE=0 * * * *
KEEPER_MAX_CONCURRENT_WORKERS=5
KEEPER_MAX_RETRY_ATTEMPTS=3
KEEPER_GAS_LIMIT_XLM=70

# ===== WEBHOOK SERVICE =====
WEBHOOK_SIGNING_SECRET=CHANGE_ME
WEBHOOK_MAX_RETRIES=5
WEBHOOK_CIRCUIT_BREAKER_THRESHOLD=100

# ===== RATE LIMITING =====
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_PER_IP=100
RATE_LIMIT_MAX_PER_API_KEY=1000

# ===== CORS =====
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ===== EMAIL (SendGrid) =====
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@recurra.io

# ===== MONITORING (Datadog) =====
DD_API_KEY=
DD_APP_KEY=
DD_SERVICE=recurra

# ===== KYC (SumSub) =====
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=

# ===== IPFS (Pinata) =====
PINATA_API_KEY=
PINATA_SECRET_KEY=

# ===== FIAT ON-RAMP =====
MOONPAY_API_KEY=
TRANSAK_API_KEY=

# ===== ADMIN MULTI-SIG =====
ADMIN_KEY_1=
ADMIN_KEY_2=
ADMIN_KEY_3=
ADMIN_THRESHOLD=2

# ===== AWS KMS (Production Only) =====
AWS_REGION=
AWS_KMS_KEY_ID=
