# ============================================================
# RECURRA BACKEND — MAINNET ENVIRONMENT TEMPLATE
# ============================================================
# Copy this to .env and fill in your mainnet values.
# NEVER commit .env files with real keys!
# ============================================================

# ===== APPLICATION =====
NODE_ENV=production
APP_PORT=3001
APP_HOST=0.0.0.0
APP_NAME=recurra
LOG_LEVEL=info

# ===== DATABASE (PostgreSQL) =====
DATABASE_URL=<your-production-database-url>
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_SSL=true

# ===== REDIS =====
REDIS_URL=<your-production-redis-url>
REDIS_PASSWORD=
REDIS_TLS=true

# ===== AUTHENTICATION =====
JWT_SECRET=<generate-a-secure-64-char-random-string>
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=recurra.io

# ===== STELLAR NETWORK (MAINNET) =====
STELLAR_NETWORK=mainnet
STELLAR_RPC_URL=https://soroban-rpc.mainnet.stellar.gateway.fm
STELLAR_HORIZON_URL=https://horizon.stellar.org
STELLAR_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015

# ===== CONTRACT ADDRESSES (MAINNET — fill after deploy_mainnet.ps1) =====
CONTRACT_AUTHORIZATION_MANAGER=<mainnet-auth-contract-address>
CONTRACT_SUBSCRIPTION_FACTORY=<mainnet-factory-contract-address>
CONTRACT_PAYMENT_ENGINE=<mainnet-engine-contract-address>
CONTRACT_TOKEN_WRAPPER=<mainnet-token-wrapper-address>
CONTRACT_ESCROW_DISPUTE=<mainnet-escrow-contract-address>

# Mainnet USDC (Circle) — verify at https://stellar.expert/explorer/public
USDC_TOKEN_ADDRESS=CCW67TSZV3SSS2HXMBQ5JFGCKJNXKZM7UQUWUZPUTHXSTZLEO7SJMI

# ===== KEEPER SERVICE (MAINNET) =====
# CRITICAL: This key holds real XLM and signs real transactions!
# Use AWS KMS in production instead of a raw secret key.
KEEPER_PRIVATE_KEY=<mainnet-keeper-secret-key>
KEEPER_CRON_SCHEDULE=*/15 * * * *
KEEPER_MAX_CONCURRENT_WORKERS=5
KEEPER_MAX_RETRY_ATTEMPTS=3
KEEPER_GAS_LIMIT_XLM=70

# ===== WEBHOOK SERVICE =====
WEBHOOK_SIGNING_SECRET=<generate-a-secure-secret>
WEBHOOK_MAX_RETRIES=5
WEBHOOK_CIRCUIT_BREAKER_THRESHOLD=100

# ===== RATE LIMITING =====
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_PER_IP=100
RATE_LIMIT_MAX_PER_API_KEY=1000

# ===== CORS =====
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# ===== EMAIL (SendGrid) =====
SENDGRID_API_KEY=<your-sendgrid-api-key>
SENDGRID_FROM_EMAIL=noreply@recurra.io

# ===== ADMIN MULTI-SIG =====
ADMIN_KEY_1=<admin-public-key-1>
ADMIN_KEY_2=<admin-public-key-2>
ADMIN_KEY_3=<admin-public-key-3>
ADMIN_THRESHOLD=2

# ===== AWS KMS (Recommended for Production) =====
AWS_REGION=<your-aws-region>
AWS_KMS_KEY_ID=<your-kms-key-id>
