# ============================================
# RECURRA — ENVIRONMENT VARIABLES
# NEVER commit .env files with real values!
# ============================================

# ===== APPLICATION =====
NODE_ENV=development
APP_PORT=3001
APP_HOST=localhost
APP_NAME=recurra
LOG_LEVEL=info

# ===== DATABASE (PostgreSQL) =====
DATABASE_URL=postgresql://recurra:recurra_dev@localhost:5432/recurra_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# ===== REDIS =====
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_TLS=false

# ===== AUTHENTICATION =====
JWT_SECRET=YOUR_SECRET_HERE
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=recurra.io

# ===== STELLAR NETWORK =====
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
PLATFORM_FEE_WALLET=GATZRECURRADEVWALLETFEECOLLECTORAAAAAAAAAAAAAAAAAAAAAA

# ===== CONTRACT ADDRESSES (Testnet) =====
CONTRACT_AUTHORIZATION_MANAGER=
CONTRACT_SUBSCRIPTION_FACTORY=
CONTRACT_PAYMENT_ENGINE=
CONTRACT_TOKEN_WRAPPER=
CONTRACT_ESCROW_DISPUTE=
USDC_TOKEN_ADDRESS=CD5TE4CUOKX6T5UMHL4JUTX7FTCN2G7CK3XPP7XV35COKJ6RZA6SG7YR

# ===== KEEPER SERVICE =====
KEEPER_PRIVATE_KEY=YOUR_SECRET_KEY
KEEPER_CRON_SCHEDULE=0 * * * *
KEEPER_MAX_CONCURRENT_WORKERS=5
KEEPER_MAX_RETRY_ATTEMPTS=3
KEEPER_GAS_LIMIT_XLM=70

# ===== WEBHOOK SERVICE =====
WEBHOOK_SIGNING_SECRET=CHANGE_ME
WEBHOOK_MAX_RETRIES=5
WEBHOOK_CIRCUIT_BREAKER_THRESHOLD=100

# ===== RATE LIMITING =====
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_PER_IP=100
RATE_LIMIT_MAX_PER_API_KEY=1000

# ===== CORS =====
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# ===== EMAIL (SendGrid) =====
SENDGRID_API_KEY=YOUR_SENDGRID_KEY
SENDGRID_FROM_EMAIL=noreply@recurra.io

# ===== RETAIL STOREFRONT =====
SUPER_MERCHANT_ID=11111111-1111-1111-1111-111111111111
