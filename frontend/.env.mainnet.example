# ============================================================
# RECURRA FRONTEND — MAINNET ENVIRONMENT TEMPLATE
# ============================================================
# Copy this to .env and fill in your mainnet values.
# ============================================================

# The URL of the backend API (production)
VITE_API_URL=https://your-backend-url.com

# Stellar Network Selection — MAINNET for production
VITE_STELLAR_NETWORK=MAINNET

# Payment Engine Contract Address (fill after deploy_mainnet.ps1)
VITE_CONTRACT_PAYMENT_ENGINE=<mainnet-payment-engine-contract-address>

# Mainnet USDC (Circle) — verify at https://stellar.expert/explorer/public
VITE_USDC_TOKEN_ADDRESS=CCW67TSZV3SSS2HXMBQ5JFGCKJNXKZM7UQUWUZPUTHXSTZLEO7SJMI
